# ReviewGuard — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=development   # development | staging | production
DEBUG=true
PROJECT_NAME=ReviewGuard
VERSION=1.0.0

# ============================================================
# DATABASE
# ============================================================
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./reviewguard.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/reviewguard

# ============================================================
# AI PROVIDERS
# ============================================================
# Primary provider: ollama | gemini | mock
AI_PROVIDER=ollama

# Ollama (local — free, private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=45

# Google Gemini (cloud — requires API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# GITHUB INTEGRATION
# ============================================================
# Personal Access Token (dev/testing only)
GITHUB_TOKEN=

# GitHub App (production)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

GITHUB_API_URL=https://api.github.com

# ============================================================
# AUTHENTICATION (when implemented)
# ============================================================
JWT_SECRET_KEY=CHANGE_ME_RANDOM_256_BIT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# REVIEW ENGINE TUNING
# ============================================================
DEDUPLICATION_SIMILARITY_THRESHOLD=0.78
STATIC_ANALYSIS_ENABLED=true
MAX_DIFF_LINES_PER_FILE=1500

# ============================================================
# FRONTEND (Vite — prefix with VITE_)
# ============================================================
# Base URL of the backend API (used in production builds)
# VITE_API_BASE_URL=https://api.reviewguard.dev
